# Generate fresh random hexadecimal values before starting (see docs/VPS_DEPLOYMENT.md).
POSTGRES_PASSWORD=replace-with-64-hex-characters
POSTGREST_DB_PASSWORD=replace-with-64-hex-characters
JWT_SECRET_KEY=replace-with-a-different-64-character-secret
INTERNAL_DATABASE_JWT_SECRET=replace-with-another-different-64-character-secret

# VPS only: point this name to the server's public IP before enabling the vps profile.
DOMAIN=your-domain.example
CORS_ORIGINS=http://localhost:3000,https://your-domain.example

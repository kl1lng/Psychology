# Local PostgreSQL/PostgREST API
DATABASE_API_URL=http://localhost:3001
INTERNAL_DATABASE_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
LOCAL_STORAGE_PATH=app/static

# Application login tokens
JWT_SECRET_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
